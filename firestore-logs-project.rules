rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Logs — write-only, structured validation, no reads, no deletes.
    // Apply this ruleset on the SEPARATE logs Firebase project, not the
    // main project. See functions/logsProjectLogger.js for why.
    match /logs/{username}/access_logs/{logId} {

      allow create: if
        request.resource.data.keys().hasAll(['event_type', 'username', 'success', 'timestamp']) &&
        request.resource.data.event_type in [
          'signup_success', 'signup_failed', 'signup_blocked',
          'login_success', 'login_failed',
          'password_recovery_success', 'password_recovery_failed'
        ] &&
        request.resource.data.username == username &&
        request.resource.data.success is bool;

      allow read: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
